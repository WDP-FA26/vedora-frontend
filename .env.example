# Public build-time configuration. Next.js inlines NEXT_PUBLIC_* values into
# the client bundle, so a missing value stops `next dev`, `next build` or
# `next start` immediately (see lib/env.ts).

# Vedora API (called by both the Next server and the browser).
NEXT_PUBLIC_API_URL=http://localhost:4000/api/v1

# RustFS public origin (blog images, presigned uploads).
NEXT_PUBLIC_STORAGE_URL=http://localhost:9000

# Cloudinary cloud name; required for video playback.
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=

# Cloudflare Turnstile site key. Optional locally (Cloudflare's always-pass
# test key is used); required for production builds.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
